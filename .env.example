PROJECT_NAME="ViralCut AI - Automated Short-Form Video Platform"
DEBUG=True
API_V1_STR="/api/v1"

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viral_video_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/viral_video_db

# Redis & ARQ Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security - AES-256-GCM Master Key (32 bytes hex encoded or base64 key string)
ENCRYPTION_MASTER_KEY=4f8a9b2c1d3e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=viral-video-assets-bucket

# AWS Remotion Lambda Config
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render-function
REMOTION_SERVE_URL=https://remotion-lambda-assets.s3.us-east-1.amazonaws.com/sites/viral-short-template/index.html
REMOTION_COMPOSITION_ID=ShortVideoComposition
